# RuleFreeze Public Configuration Interface
# Allowed variables are exposed to the browser via the validated /api/public-config route.

# Canonical Deployed GenLayer Contract Address (0x... 40 hex chars)
# Leave blank or unconfigured to keep application in read-only setup mode with diagnostic instructions.
PUBLIC_CONTRACT_ADDRESS=

# GenLayer Studionet RPC endpoint
PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# GenLayer Studionet Chain ID (61999 = 0xf22f)
PUBLIC_GENLAYER_CHAIN_ID=61999

# Node / Production Server Settings
PORT=48820
HOST=0.0.0.0
NODE_ENV=production
